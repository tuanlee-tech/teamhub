# Application
NEXT_PUBLIC_TEAMHUB_URL=http://127.0.0.1:3000

# Supabase public client
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Supabase privileged server access. Never expose this as NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_REPLACE_ME

# SePay webhook HMAC secret (optional, for payment reconciliation)
TEAMHUB_SEPAY_SECRET=replace_with_hmac_secret

# VAPID keys for Web Push (optional, for notifications)
TEAMHUB_VAPID_PRIVATE_KEY=replace_with_vapid_private_key
